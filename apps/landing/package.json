{
  "name": "@appweaver/landing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run content:generate && bun run docs:build && vite",
    "build": "bun run content:generate && bun run blog:build && bun run docs:build && vite build && bun run apps:build",
    "content:generate": "bun run scripts/generate-content.ts",
    "docs:build": "bun run scripts/generate-docs.ts",
    "apps:build": "bun run scripts/generate-plugin-pages.ts",
    "deploy": "bun run build && vercel --prod",
    "demo:build": "bun run build && bun run demo:copy",
    "demo:copy": "bun run scripts/copy-web-demo-to-landing.ts",
    "blog:build": "bun run scripts/blog.ts build",
    "blog:publish": "bun run scripts/blog.ts publish",
    "blog:sync": "bun run scripts/blog.ts sync",
    "indexnow:submit": "bun run scripts/indexnow.ts",
    "preview": "vite preview",
    "record:story": "bun run scripts/record-landing-story.ts"
  },
  "dependencies": {
    "solid-js": "^1.9.9"
  },
  "devDependencies": {
    "github-slugger": "^2.0.0",
    "marked": "^17.0.0",
    "@tailwindcss/vite": "^4.1.4",
    "tailwindcss": "^4.1.4",
    "vite": "^7.1.7",
    "vite-plugin-solid": "^2.11.8"
  }
}
