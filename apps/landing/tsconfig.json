{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": ["vite/client", "bun"]
  },
  "include": [
    "./src/**/*",
    "./scripts/**/*",
    "./vite.config.ts",
    "../../src/**/*",
    "../../web/src/**/*"
  ]
}
