{
  "headers": [
    {
      "source": "/.well-known/nostr.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        }
      ]
    },
    {
      "source": "/.well-known/lnurlp/:name",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/nostr.json",
      "destination": "/api/nostr-json"
    },
    {
      "source": "/.well-known/lnurlp/:name",
      "destination": "/api/lnurlp?name=:name"
    },
    {
      "source": "/one-page",
      "destination": "/index.html"
    },
    {
      "source": "/todo-app",
      "destination": "/index.html"
    },
    {
      "source": "/bookmark-manager",
      "destination": "/index.html"
    },
    {
      "source": "/job-scheduler",
      "destination": "/index.html"
    },
    {
      "source": "/file-manager",
      "destination": "/index.html"
    },
    {
      "source": "/captains-log",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/demo/app",
      "destination": "/demo/app/",
      "permanent": false
    }
  ]
}
